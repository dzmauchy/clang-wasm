set(stage "@SYSROOT_OUTPUT_DIR@/sysroot")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/lib" "${stage}/share/licenses")
file(COPY "@libc_install@/include/" DESTINATION "${stage}/include")
file(COPY "@libc_install@/lib/wasm32-unknown-unknown/libc.a" "@libc_install@/lib/wasm32-unknown-unknown/libm.a" DESTINATION "${stage}/lib")
file(COPY "@libc_install@/lib/libc++.a" "@libc_install@/lib/libc++abi.a" DESTINATION "${stage}/lib")
file(COPY "@CMAKE_SOURCE_DIR@/sysroot/browser.hpp"
  "@CMAKE_BINARY_DIR@/browser_config.h" DESTINATION "${stage}/include")
file(COPY "@CMAKE_BINARY_DIR@/libbrowser.a" DESTINATION "${stage}/lib")
file(COPY "@CLANG_RESOURCE_DIR@/include"
  DESTINATION "${stage}/lib/clang/@CLANG_RESOURCE_VERSION@")

file(GLOB_RECURSE builtins "@compiler_rt_build@/libclang_rt.builtins-wasm32.a")
list(LENGTH builtins count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "Expected one Wasm compiler-rt archive, found: ${builtins}")
endif()
file(COPY ${builtins} DESTINATION "${stage}/lib")
file(MAKE_DIRECTORY "${stage}/lib/clang/@CLANG_RESOURCE_VERSION@/lib/wasi")
# Clang's WebAssembly driver searches its resource directory here even for
# wasm32-unknown-unknown. This archive has no WASI imports or dependencies.
file(COPY ${builtins}
  DESTINATION "${stage}/lib/clang/@CLANG_RESOURCE_VERSION@/lib/wasi")
file(COPY "@LLVM_SOURCE_DIR@/llvm/LICENSE.TXT" DESTINATION "${stage}/share/licenses")
file(RENAME "${stage}/share/licenses/LICENSE.TXT" "${stage}/share/licenses/LLVM-LICENSE.TXT")
file(GLOB_RECURSE archives "${stage}/*.a")
execute_process(COMMAND "@SYSROOT_STRIP@" --strip-debug ${archives}
  COMMAND_ERROR_IS_FATAL ANY)
file(GLOB_RECURSE entries RELATIVE "@SYSROOT_OUTPUT_DIR@" "${stage}/*")
list(SORT entries)
file(ARCHIVE_CREATE OUTPUT "@SYSROOT_OUTPUT_DIR@/sysroot.tgz"
  PATHS ${entries} FORMAT gnutar COMPRESSION GZip COMPRESSION_LEVEL 9)
