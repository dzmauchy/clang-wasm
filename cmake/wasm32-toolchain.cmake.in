set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR wasm32)
set(CMAKE_C_COMPILER "@SYSROOT_CLANG@")
set(CMAKE_CXX_COMPILER "@SYSROOT_CLANGXX@")
set(CMAKE_ASM_COMPILER "@SYSROOT_CLANG@")
set(CMAKE_C_COMPILER_TARGET wasm32-unknown-unknown)
set(CMAKE_CXX_COMPILER_TARGET wasm32-unknown-unknown)
set(CMAKE_ASM_COMPILER_TARGET wasm32-unknown-unknown)
set(CMAKE_AR "@SYSROOT_AR@")
set(CMAKE_RANLIB "@SYSROOT_RANLIB@")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
